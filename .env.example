# Copie ce fichier en .env et colle tes clés (le .env n'est jamais commité).
# SerpApi (Google Flights, 250 recherches/mois gratuites) : https://serpapi.com
SERPAPI_KEY=
# Travelpayouts / Aviasales Data API (gratuit, facultatif) : https://www.travelpayouts.com
TRAVELPAYOUTS_TOKEN=
# Mot de passe de l'app. Facultatif en local, OBLIGATOIRE en ligne (Vercel) : longue phrase de passe.
APP_PASSWORD=
# Facultatif : chaîne aléatoire qui signe les sessions. La changer déconnecte tous les appareils.
SESSION_SECRET=
